{
  "manifest_version": 3,
  "name": "Aleph — AI Chat Styler",
  "version": "2.7.7",
  "description": "Hebrew & Arabic-script RTL/BiDi fixes, themes, focus mode & styling across Claude, ChatGPT & Gemini",
  "permissions": ["storage", "activeTab", "identity", "cookies", "alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "oauth2": {
    "client_id": "440163597784-t0bfi7ahtqba6dmlj0iis96d5jklc56e.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  },
  "externally_connectable": {
    "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"]
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "commands": {
    "toggle-aleph": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle Aleph on/off for this platform"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["vendor/katex/katex.min.js", "dist/content.js", "dist/insights-tracker.js", "dist/mini-game.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle"
    }
  ]
}
